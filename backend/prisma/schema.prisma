// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================
// USERS
// ============================
model User {
  id                Int      @id @default(autoincrement())
  username          String   @unique @db.VarChar(50)
  email             String   @unique @db.VarChar(255)
  password_hash     String   @db.VarChar(255)
  profile_image_url String?
  created_at        DateTime @default(now())

  saved_restaurants        SavedRestaurant[]
  lobbies_created          Lobby[]
  lobby_memberships        LobbyMember[]
  restaurant_options_added LobbyRestaurantOption[]
  votes                    Vote[]
  messages                 Message[]

  @@map("users")
}

// ============================
// RESTAURANTS
// Cached info pulled from Google Places / Yelp so you're not
// re-fetching the API every time.
// ============================
model Restaurant {
  id           Int      @id @default(autoincrement())
  api_place_id String   @unique @db.VarChar(255)
  name         String   @db.VarChar(255)
  address      String?
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  rating       Decimal? @db.Decimal(2, 1)
  price_level  Int?
  photo_url    String?
  cached_at    DateTime @default(now())

  saved_by          SavedRestaurant[]
  chosen_by_lobbies Lobby[]
  lobby_options     LobbyRestaurantOption[]
  votes             Vote[]

  @@map("restaurants")
}

// ============================
// SAVED RESTAURANTS (user's personal list)
// ============================
model SavedRestaurant {
  id            Int      @id @default(autoincrement())
  user_id       Int
  restaurant_id Int
  saved_at      DateTime @default(now())

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@unique([user_id, restaurant_id])
  @@map("saved_restaurants")
}

// ============================
// LOBBIES
// ============================
model Lobby {
  id                   Int       @id @default(autoincrement())
  name                 String?   @db.VarChar(100)
  created_by           Int
  status               String    @default("active") @db.VarChar(20) // active | voting | eating | closed
  chosen_restaurant_id Int?
  invite_code          String?   @unique @db.VarChar(10)
  created_at           DateTime  @default(now())
  closed_at            DateTime?

  creator           User        @relation(fields: [created_by], references: [id])
  chosen_restaurant Restaurant? @relation(fields: [chosen_restaurant_id], references: [id])

  members            LobbyMember[]
  restaurant_options LobbyRestaurantOption[]
  votes              Vote[]
  messages           Message[]

  @@map("lobbies")
}

// ============================
// LOBBY MEMBERS
// ============================
model LobbyMember {
  id        Int      @id @default(autoincrement())
  lobby_id  Int
  user_id   Int
  joined_at DateTime @default(now())
  ready     Boolean  @default(false)

  lobby Lobby @relation(fields: [lobby_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([lobby_id, user_id])
  @@map("lobby_members")
}

// ============================
// LOBBY RESTAURANT OPTIONS (the shortlist to vote on)
// ============================
model LobbyRestaurantOption {
  id            Int @id @default(autoincrement())
  lobby_id      Int
  restaurant_id Int
  added_by      Int

  lobby      Lobby      @relation(fields: [lobby_id], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurant_id], references: [id])
  adder      User       @relation(fields: [added_by], references: [id])

  @@unique([lobby_id, restaurant_id])
  @@map("lobby_restaurant_options")
}

// ============================
// VOTES
// ============================
model Vote {
  id            Int      @id @default(autoincrement())
  lobby_id      Int
  user_id       Int
  restaurant_id Int
  voted_at      DateTime @default(now())

  lobby      Lobby      @relation(fields: [lobby_id], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurant_id], references: [id])

  @@unique([lobby_id, user_id]) // one vote per person per lobby
  @@map("votes")
}

// ============================
// MESSAGES (lobby chat)
// ============================
model Message {
  id        Int      @id @default(autoincrement())
  lobby_id  Int
  user_id   Int
  content   String? // nullable if it's an image-only message
  image_url String?
  sent_at   DateTime @default(now())

  lobby Lobby @relation(fields: [lobby_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("messages")
}
